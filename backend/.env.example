# Firebase Configuration
FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your_project.firebaseio.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Apple Pay Configuration
APPLE_PAY_MERCHANT_ID=merchant.com.yourcompany.creativeworkspace
APPLE_PAY_CERTIFICATE_PATH=./certs/apple_pay.p8
APPLE_PAY_KEY_ID=your_key_id
APPLE_PAY_TEAM_ID=your_team_id

# Server Configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SENDER_EMAIL=noreply@creativeworkspace.app

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:19000
MOBILE_APP_URL=exp://localhost:19000

# Firebase Admin SDK (optional - if using service account)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-key.json

# Logging
LOG_LEVEL=debug
